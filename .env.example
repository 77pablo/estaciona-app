# Estaciona — variables de entorno (plantilla)
# Copiá este archivo a .env y completá los valores. NUNCA subas el .env real.

# --- Servidor ---
PORT=4124
# Nº de proxies de confianza delante de la app (Railway suele ser 1). Se usa
# para leer la IP real del cliente en el rate limiting.
TRUST_PROXY_HOPS=

# --- Base de datos ---
# En producción: cadena de conexión de PostgreSQL/Neon.
DATABASE_URL=
# Solo si el proveedor de PG da problemas de certificado (poner en 1). Riesgo:
# desactiva verificación TLS. Evitar salvo necesidad.
DB_SSL_NO_VERIFY=
# En local (sin DATABASE_URL) se usa SQLite en esta ruta.
SQLITE_PATH=./data/estaciona.sqlite
# En PRODUCCIÓN la app NO arranca sin DATABASE_URL (los datos se perderían en
# cada redeploy). Poné 1 solo si de verdad querés datos efímeros en prod.
PERMITIR_SIN_DB=

# --- Acceso privado / admin ---
# Clave para el panel /admin y acciones protegidas. Obligatoria en producción.
ACCESO_CLAVE=

# --- Geocoder (elige el proveedor con GEOCODER) ---
# nominatim | locationiq | maptiler
GEOCODER=nominatim
NOMINATIM_URL=
LOCATIONIQ_KEY=
MAPTILER_KEY=

# --- Fotos: almacenamiento Cloudflare R2 (opcional; si falta, se usa disco) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Directorio local de fotos cuando no se usa R2.
FOTOS_DIR=./data/fotos
# Poner en 1 para saltar la moderación de fotos (solo desarrollo).
FOTOS_SIN_MODERAR=

# --- Moderación de imágenes (Sightengine; opcional) ---
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# --- Rutas de datos JSON (opcionales; tienen default) ---
LUGARES_PATH=
APORTES_PATH=
VOTOS_PATH=
DESTACADOS_PATH=
ANALYTICS_PATH=

# --- Debug ---
# Poner en 1 para desactivar la Content-Security-Policy (solo desarrollo).
CSP_OFF=
