# Dependencias (Estaciona no usa, pero por si acaso)
node_modules/

# Logs y temporales
*.log
npm-debug.log*

# Datos generados en runtime (votos y aportes de la gente)
votos.json
aportes.json

# Secretos / entorno
.env
.env.*
# Key de MapTiler para correr en local (en Railway se usa la variable MAPTILER_KEY)
maptiler.key
# Key de TomTom para correr en local (en Railway se usa la variable TOMTOM_KEY)
tomtom.key

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini
