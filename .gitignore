# Dependencias (Estaciona no usa, pero por si acaso)
node_modules/

# Logs y temporales
*.log
npm-debug.log*

# Datos generados en runtime (votos, aportes y fotos de la gente)
votos.json
aportes.json
fotos/

# Secretos / entorno
.env
.env.*
# Key de MapTiler para correr en local (en Railway se usa la variable MAPTILER_KEY)
maptiler.key
# Key de TomTom para correr en local (en Railway se usa la variable TOMTOM_KEY)
tomtom.key

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Clave de moderación local (en Railway: ADMIN_CLAVE)
admin.key
# Credenciales de Sightengine para correr en local (en Railway: SIGHTENGINE_USER/SECRET)
sightengine.key
# Códigos de Estaciona Pro para correr en local (en Railway: PRO_CODES)
pro-codes.key
